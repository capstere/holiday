    "apply:annotation-patch": "node scripts/apply-annotation-patch.mjs public/data/plan5f.manual-v0.json",
    "export:z4-geometry": "node scripts/export-z4-geometry.mjs public/data/plan5f.manual-v0.json public/generated/z4.geometry-v0.json"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "latest",
    "vite": "latest",
    "three": "latest"
  },
  "devDependencies": {}
